# HomeIsland settings.
#
# install.sh copies this file to /etc/homeisland/homeisland.env and fills in
# detected values. Edit the copy in /etc/homeisland, never this file, then run:
#
#     sudo homeisland apply
#
# Secrets (passwords) are generated into /etc/homeisland/secrets.env and are
# never stored here. All addresses below are examples.

# -- Network -------------------------------------------------------------------

# Local DNS domain. home.arpa is reserved for home networks (RFC 8375).
# Do not use .local, which belongs to mDNS.
HOMEISLAND_DOMAIN=home.arpa

# LAN address of this server. Reserve it in your router's DHCP settings so it
# never changes; all local DNS names point here.
HOMEISLAND_HOST_IP=192.168.1.10

# Address that published ports bind to. Empty = HOMEISLAND_HOST_IP.
# Binding to the LAN address keeps services off other interfaces (VPNs, WAN).
HOMEISLAND_BIND_IP=

# Port of the web dashboard and reverse proxy.
HOMEISLAND_HTTP_PORT=80

# Port Pi-hole listens on. Clients always expect 53; change only for testing.
HOMEISLAND_DNS_PORT=53

# Upstream DNS servers for Internet names, separated by ';'.
# Local names under HOMEISLAND_DOMAIN never leave this server.
HOMEISLAND_DNS_UPSTREAMS=9.9.9.9;149.112.112.112

# Days of DNS query history Pi-hole keeps (lower = fewer SSD writes).
HOMEISLAND_PIHOLE_QUERY_LOG_DAYS=7

HOMEISLAND_TZ=Etc/UTC

# -- Storage -------------------------------------------------------------------

# Configuration databases and indexes (keep on the SSD).
HOMEISLAND_STATE_DIR=/var/lib/homeisland

# Large datasets: Wikipedia, maps, documents, media, backups (HDD).
# HomeIsland never formats or mounts disks; mount the disk yourself first.
HOMEISLAND_DATA_DIR=/data/homeisland

# Owner of files on the data disk (Samba user, library, Jellyfin).
HOMEISLAND_DATA_UID=1000
HOMEISLAND_DATA_GID=1000

# -- Backups -------------------------------------------------------------------

# Empty = $HOMEISLAND_DATA_DIR/backups. Can be a mounted USB drive.
HOMEISLAND_BACKUP_DIR=
HOMEISLAND_BACKUP_KEEP=14

# -- Monitoring ----------------------------------------------------------------

# Internet detection: TCP handshakes to several independent public resolvers.
# Online if any answers. No data is sent. Set HOMEISLAND_WAN_CHECK=false to disable.
HOMEISLAND_WAN_CHECK=true
HOMEISLAND_WAN_TARGETS=1.1.1.1:53 9.9.9.9:53 8.8.8.8:53 208.67.222.222:53
HOMEISLAND_WAN_INTERVAL=30
HOMEISLAND_COLLECT_INTERVAL=15

# SMART checks skip sleeping disks, so they do not prevent spindown.
HOMEISLAND_SMART_INTERVAL=1800
# Empty = autodetect. USB bridges may need e.g. "/dev/sda" with a device type
# that smartctl --scan reports.
HOMEISLAND_SMART_DEVICES=

# -- Knowledge -----------------------------------------------------------------

HOMEISLAND_LIBRARY_REINDEX_HOURS=6

# -- Maps ----------------------------------------------------------------------

# Where `homeisland maps download` extracts regions from (only used when run).
HOMEISLAND_MAPS_SOURCE=https://build.protomaps.com

# -- Hardware modules (only used when the module is enabled) --------------------

# bme280
HOMEISLAND_BME280_BUS=1
HOMEISLAND_BME280_ADDRESS=0x76
HOMEISLAND_BME280_LABEL=Rack

# ups (Network UPS Tools on the host)
HOMEISLAND_UPS_NAME=ups@localhost

# fan (experimental; read docs/HARDWARE.md before enabling)
HOMEISLAND_FAN_PWMCHIP=0
HOMEISLAND_FAN_CHANNEL=0
# 40000 ns = 25 kHz, the PWM frequency 4-pin PC fans expect.
HOMEISLAND_FAN_PERIOD_NS=40000
# Temperature source: cpu, hdd or sensor.
HOMEISLAND_FAN_SOURCE=cpu
HOMEISLAND_FAN_MIN_TEMP=45
HOMEISLAND_FAN_MAX_TEMP=70
HOMEISLAND_FAN_MIN_DUTY=20
HOMEISLAND_FAN_MAX_DUTY=100
# true if your driver circuit inverts the signal (e.g. a single NPN transistor).
HOMEISLAND_FAN_INVERT=false
